# SchemeSathi AI Environment Variables Template
# Use this template for setting environment variables on Render (Backend) and Vercel (Frontend).
# DO NOT put actual production credentials or keys in this file.

# ----------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Set on Render Dashboard)
# ----------------------------------------------------
PORT=8080

# Database Configuration (Neon PostgreSQL)
# Format: jdbc:postgresql://<NEON_HOST>/<NEON_DATABASE>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Google Gemini AI Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Security JWT Secret Key (min 256-bit base64 / hex key)
JWT_SECRET=your_secure_jwt_secret_key_here

# Frontend Application URL for CORS Preflight (Vercel Production URL)
FRONTEND_URL=https://your-scheme-sathi-frontend.vercel.app

# ----------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Set on Vercel Dashboard)
# ----------------------------------------------------
# Render Backend URL
VITE_API_BASE_URL=https://your-scheme-sathi-backend.onrender.com
